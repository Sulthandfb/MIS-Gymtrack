INSERT INTO public.chat_message VALUES (131, 1, 'bot', 'Halo! Saya senang membantu Anda mencari informasi tentang member gym kami. Anda bertanya tentang sentiment feedback member secara keseluruhan. Saya dapat memberikan informasi terkait dengan data yang tersedia.

